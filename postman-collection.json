{
  "info": {
    "name": "Spring Boot Redis Cache API",
    "description": "Production-grade Spring Boot application with Redis distributed caching",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Products",
      "description": "Product CRUD operations with reference-data cache (1h TTL)",
      "item": [
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            },
            "description": "Read-through cache: First call hits DB, subsequent calls hit cache"
          }
        },
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Not cached to avoid memory issues with large collections"
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Product\",\n  \"description\": \"Product description\",\n  \"category\": \"Electronics\",\n  \"price\": 199.99,\n  \"stockQuantity\": 50,\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Write-through cache: Product is added to cache after save"
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Product\",\n  \"description\": \"Updated description\",\n  \"category\": \"Electronics\",\n  \"price\": 299.99,\n  \"stockQuantity\": 25,\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            },
            "description": "Cache put: Updates cache with new value"
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            },
            "description": "Cache evict: Removes entry from cache"
          }
        },
        {
          "name": "Clear Product Cache",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/cache",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "cache"]
            },
            "description": "Clears all product cache entries"
          }
        }
      ]
    },
    {
      "name": "Users",
      "description": "User operations with user-data cache (5m TTL)",
      "item": [
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "1"]
            }
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"email\": \"newuser@example.com\",\n  \"firstName\": \"New\",\n  \"lastName\": \"User\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"updateduser\",\n  \"email\": \"updated@example.com\",\n  \"firstName\": \"Updated\",\n  \"lastName\": \"User\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "1"]
            }
          }
        },
        {
          "name": "Record Login",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/1/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "1", "login"]
            },
            "description": "Updates lastLoginAt and refreshes cache"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "External API",
      "description": "External API responses with api-response cache (30s TTL)",
      "item": [
        {
          "name": "Get Exchange Rate",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/external/exchange-rate?base=USD&target=EUR",
              "host": ["{{baseUrl}}"],
              "path": ["api", "external", "exchange-rate"],
              "query": [
                {
                  "key": "base",
                  "value": "USD"
                },
                {
                  "key": "target",
                  "value": "EUR"
                }
              ]
            },
            "description": "Simulated external API - cached for 30 seconds"
          }
        },
        {
          "name": "Get Weather",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/external/weather/London",
              "host": ["{{baseUrl}}"],
              "path": ["api", "external", "weather", "London"]
            },
            "description": "Simulated weather API - cached for 30 seconds"
          }
        }
      ]
    },
    {
      "name": "Cache Management",
      "description": "Cache operations and monitoring",
      "item": [
        {
          "name": "Cache Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cache/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cache", "health"]
            },
            "description": "Redis connectivity check"
          }
        },
        {
          "name": "Cache Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cache/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cache", "stats"]
            },
            "description": "Cache names and Redis memory info"
          }
        },
        {
          "name": "List Cache Keys",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cache/keys?pattern=app:v1:*",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cache", "keys"],
              "query": [
                {
                  "key": "pattern",
                  "value": "app:v1:*"
                }
              ]
            },
            "description": "List keys matching pattern"
          }
        },
        {
          "name": "Clear Specific Cache",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cache/reference-data",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cache", "reference-data"]
            },
            "description": "Clear a specific cache by name"
          }
        },
        {
          "name": "Clear All Caches",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cache",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cache"]
            },
            "description": "Clear all caches"
          }
        }
      ]
    },
    {
      "name": "Actuator",
      "description": "Spring Boot Actuator endpoints",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            }
          }
        },
        {
          "name": "Prometheus Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/prometheus",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "prometheus"]
            },
            "description": "Cache hit/miss metrics and Redis connection stats"
          }
        },
        {
          "name": "Caches Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/caches",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "caches"]
            }
          }
        },
        {
          "name": "Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "metrics"]
            }
          }
        },
        {
          "name": "Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/info",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "info"]
            }
          }
        }
      ]
    }
  ]
}
